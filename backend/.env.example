# Copy this to .env for local dev, or set these as Kubernetes secrets/configmaps in prod.

# --- App ---
APP_NAME=DreamCast API
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=["*"]

# --- Database ---
DATABASE_URL=postgresql://dreamcast:dreamcast@localhost:5432/dreamcast

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-6
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_URL=https://api.stability.ai/v2beta/stable-image/generate/core

# --- Payments: fill in ONE provider's keys ---
PAYMENT_PROVIDER=stripe
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# Google Play Billing
GOOGLE_PLAY_PACKAGE_NAME=com.dreamcast.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# RevenueCat (recommended if adding iOS later)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Tier limits ---
FREE_TIER_WEEKLY_LIMIT=1
PRO_TIER_DAILY_LIMIT=10

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
