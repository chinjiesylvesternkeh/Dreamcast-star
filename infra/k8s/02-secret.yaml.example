# DO NOT commit a real filled-in version of this file to git.
#
# This is a TEMPLATE. In practice, create the real secret one of these ways:
#
#   1. Imperatively (simplest, good for solo devs):
#        kubectl create secret generic dreamcast-secrets \
#          --namespace dreamcast \
#          --from-literal=DATABASE_URL='postgresql://user:pass@host:5432/dreamcast' \
#          --from-literal=JWT_SECRET_KEY='<random-64-char-string>' \
#          --from-literal=ANTHROPIC_API_KEY='sk-ant-...' \
#          --from-literal=IMAGE_PROVIDER_API_KEY='...' \
#          --from-literal=STRIPE_SECRET_KEY='sk_live_...' \
#          --from-literal=STRIPE_WEBHOOK_SECRET='whsec_...' \
#          --from-literal=STRIPE_PRICE_ID_MONTHLY='price_...' \
#          --from-literal=GOOGLE_PLAY_SERVICE_ACCOUNT_JSON="$(cat play-service-account.json)" \
#          --from-literal=REVENUECAT_API_KEY='' \
#          --from-literal=REVENUECAT_WEBHOOK_SECRET='' \
#          --from-literal=REDIS_URL='redis://dreamcast-redis:6379/0' \
#          --from-literal=SENTRY_DSN=''
#
#   2. Via Jenkins (see Jenkinsfile) using Jenkins Credentials Store,
#      injected at deploy time — recommended for CI/CD.
#
#   3. Via a secrets manager (Google Secret Manager / AWS Secrets Manager)
#      + External Secrets Operator, which syncs into a real Secret
#      automatically — recommended long-term for production.
#
# Below is the shape of the Secret object for reference only:

apiVersion: v1
kind: Secret
metadata:
  name: dreamcast-secrets
  namespace: dreamcast
type: Opaque
stringData:
  DATABASE_URL: "postgresql://REPLACE_ME:REPLACE_ME@dreamcast-postgres:5432/dreamcast"
  JWT_SECRET_KEY: "REPLACE_ME_WITH_LONG_RANDOM_STRING"
  ANTHROPIC_API_KEY: "REPLACE_ME"
  IMAGE_PROVIDER_API_KEY: "REPLACE_ME"
  STRIPE_SECRET_KEY: "REPLACE_ME"
  STRIPE_WEBHOOK_SECRET: "REPLACE_ME"
  STRIPE_PRICE_ID_MONTHLY: "REPLACE_ME"
  GOOGLE_PLAY_SERVICE_ACCOUNT_JSON: "REPLACE_ME_WITH_RAW_JSON"
  REVENUECAT_API_KEY: ""
  REVENUECAT_WEBHOOK_SECRET: ""
  REDIS_URL: "redis://dreamcast-redis:6379/0"
  SENTRY_DSN: ""
